# ===========================================
# Ollama 전용 환경 설정 (OpenAI API 미사용)
# ===========================================
# 이 파일을 .env 또는 .env.local로 복사하여 사용하세요.
# Firebase 배포를 하지 않으므로 Ollama만 사용합니다.
#
# 사용 모델:
#   - 텍스트: llama3.2:3b (Meta, 중국어 편향 없음)
#   - Vision/OCR: llama3.2-vision:11b
#   - 한글 특화(선택): EEVE-Korean → npm run proxy:ollama 실행 전
#     set OLLAMA_MODEL_TEXT=seungduk-yanolja/EEVE-Korean-Instruct-7B-v2.0-Preview
#
# 실행 순서:
#   1. ollama pull llama3.2:3b
#   2. ollama pull llama3.2-vision:11b
#   3. (선택) 한글 품질 향상: ollama pull seungduk-yanolja/EEVE-Korean-Instruct-7B-v2.0-Preview
#   4. npm run proxy:ollama
#   5. npm start
# ===========================================

REACT_APP_API_PROXY_URL=http://localhost:4000
